# Specific environment variables for testing
DATABASE_PROVIDER=postgres # or mongo

# App
APP_NAME = boilerplate-api
APP_VERSION = 1.1.0
# APP_HOST = 127.0.0.1
# APP_PORT = 3789
APP_BASE_ENDPOINT = http://localhost:4789

APP_SOCKET_HOST = 127.0.0.1
APP_SOCKET_PORT = 1337

API_KEY = 60553d58c41f5dfa095b34b9

# Database MongoDB
MONGO_USER =
MONGO_PASS =
MONGO_NAME = boilerplate-api
MONGO_HOST = 
MONGO_PORT = 
MONGO_QUERY = ?retryWrites=true&w=majority
# MONGO_URI = mongodb://${MONGO_USER}:${MONGO_PASS}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_NAME}${MONGO_QUERY}

# Database PostgreSQL
PGSQL_USER = postgres
PGSQL_PASS = postgres
PGSQL_NAME = test-boilerplate-api
PGSQL_HOST = 
PGSQL_PORT = 
PGSQL_QUERY = ?sslmode=disable
# PGSQL_URI="postgresql://${PGSQL_USER}:${PGSQL_PASS}@${PGSQL_HOST}:${PGSQL_PORT}/${PGSQL_NAME}${PGSQL_QUERY}"

# Redis
REDIS_HOST = 127.0.0.1
REDIS_PORT = 34302

# Log
LOG_LEVEL = debug
LOG_DIR = logs
LOG_FORMAT = testing
LOG_CONSOLE = 0
LOG_EVENT_LOOP = 0
LOG_ORIGIN_REQUEST_ID_HEADER = x-origin-request-id

# Frontend
FRONTEND_BASE_URL = http://localhost:3000
FRONTEND_RESET_PASSWORD_URL = ${FRONTEND_BASE_URL}/reset-password

# Mailer
EMAIL_FROM =
EMAIL_AUTH_USER =
EMAIL_AUTH_PASS =
COMPANY_NAME = boilerplate-company

# Crypto
COOKIE_SIGN_SECRET = "defaultCookieSecret"
ACCESS_TOKEN_SECRET = "defaultAccessTokenSecret"
REFRESH_TOKEN_SECRET = "defaultRefreshTokenSecret"
EMAIL_VALIDATION_SECRET = "defaultEmailValidationSecret"