# =============================================================================
# Lovable Migration Boilerplate - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=migration-boilerplate
APP_VERSION=1.0.0
APP_HOST=127.0.0.1
APP_PORT=4789
APP_BASE_ENDPOINT=http://localhost:4789

# -----------------------------------------------------------------------------
# Database Configuration
# Note: Use port 54320 when running via docker-compose (see docker/docker-compose.yml)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:54320/myproject"
DIRECT_URL="postgresql://postgres:postgres@localhost:54320/myproject"

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Production AI Configuration (ALIA + fallback)
# -----------------------------------------------------------------------------
# ALIA (preferente)
ALIA_API_KEY="pk_drlI7lTM1mLjOU1Nm8_4GgLgbf3awmT-jD-OOB-3Xus="
ALIA_BASE_URL="https://api.nextbit256.com/onemillion/llm/v1"
ALIA_MODEL="BSC-LT/ALIA-40b-instruct_Q8_0"

# Fallback (Anthropic Sonnet 4.5, luego Llama 3.3 70b on-prem)
ANTHROPIC_API_KEY=""
FALLBACK_MODEL="claude-3-5-sonnet-20241022"

# (Opcional: para on-premise, cambiar FALLBACK_MODEL y provider a llama3.3:70b y ollama)

# -----------------------------------------------------------------------------

# Azure OpenAI Government (ENS Alto compliance)
# AI_PROVIDER="azure-openai"
# AI_BASE_URL="https://your-resource.openai.azure.com"
# AI_API_KEY="your-azure-api-key"
# AI_MODEL="gpt-4"  # Deployment name

# Google Gemini
# AI_PROVIDER="gemini"
# AI_API_KEY="your-gemini-api-key"
# AI_MODEL="gemini-2.0-flash-exp"

# -----------------------------------------------------------------------------
# Migration AI Configuration (Code Generation Only - Development)
# Separate from production AI to avoid mixing concerns
# -----------------------------------------------------------------------------
MIGRATION_AI_PROVIDER="anthropic"  # anthropic or gemini
ANTHROPIC_API_KEY=""  # For Claude Sonnet 4.5
GEMINI_API_KEY=""     # Alternative: Gemini 3

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# -----------------------------------------------------------------------------
# SSO/OIDC Configuration (OpenAM / AEAD GobTechLab)
# -----------------------------------------------------------------------------
# OIDC Issuer URL - The base URL of your OpenAM/OIDC provider
# For OpenAM: https://sso.aead.gob.es/openam/oauth2/realms/root
# For Keycloak: https://keycloak.example.com/realms/your-realm
OIDC_ISSUER_URL=""

# Client credentials (registered in OpenAM)
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# Callback URL (must match registered redirect URI in OpenAM)
OIDC_REDIRECT_URI="http://localhost:4789/api/public/sso/callback"

# Where to redirect after logout (optional)
OIDC_POST_LOGOUT_REDIRECT_URI="http://localhost:5173"

# OIDC scopes to request (space-separated)
OIDC_SCOPES="openid profile email"

# Legacy Keycloak config (deprecated - use OIDC_* instead)
# KEYCLOAK_URL="http://localhost:8080"
# KEYCLOAK_REALM="myproject"
# KEYCLOAK_CLIENT_ID="myproject-api"
# KEYCLOAK_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Redis (Rate Limiting)
# Note: Use port 35302 when running via docker-compose (see docker/docker-compose.yml)
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT="35302"
REDIS_PASSWORD=""

# -----------------------------------------------------------------------------
# MinIO Storage (S3-Compatible)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL="false"
MINIO_BUCKET_DOCUMENTS="documents"
MINIO_BUCKET_IMAGES="images"

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"  # Mailpit for development
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@myproject.com"

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
LOG_LEVEL="info"  # debug, info, warn, error
LOG_RETENTION_DAYS="90"  # Adjust based on your compliance requirements

# Prometheus
PROMETHEUS_PORT="9090"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
NODE_ENV="development"  # production, development, test
API_PORT="3000"
CORS_ORIGIN="http://localhost:5173"  # Frontend URL

# Rate Limiting (per IP)
RATE_LIMIT_MAX="1000"
RATE_LIMIT_WINDOW="15m"

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS="30"  # ENS Alto requires 30 days
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
