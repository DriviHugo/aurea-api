# =============================================================================
# AUREA API — Production Environment Configuration for AEAD
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy to .env.production
# 2. Fill in values provided by AEAD IT team (marked with *** REQUEST FROM AEAD)
# 3. Never commit .env files to git
# 4. Generate secrets with: openssl rand -base64 32
#
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────
# CRITICAL: SECRETS *** REQUEST FROM AEAD (or generate with openssl)
# ─────────────────────────────────────────────────────────────────────────
# These MUST be set. App fails at startup if missing.
# Generate: openssl rand -base64 32

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
COOKIE_SECRET=

# Optional: only needed if email verification/reset flows are enabled
EMAIL_VALIDATION_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# CRITICAL: DATABASE *** REQUEST FROM AEAD IT
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aurea_user:password@db.internal.aead:5432/aurea

# ─────────────────────────────────────────────────────────────────────────
# CRITICAL: FRONTEND URL (for CORS)
# ─────────────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=https://aurea.aead.gob.es

# Additional CORS origins (optional, comma-separated)
CORS_EXTRA_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3789

# ─────────────────────────────────────────────────────────────────────────
# EMAIL (OPTIONAL — only if you enable email flows)
# ─────────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.aead.gob.es
EMAIL_PORT=587
EMAIL_AUTH_USER=
EMAIL_AUTH_PASS=
EMAIL_FROM=aurea@aead.gob.es

# ─────────────────────────────────────────────────────────────────────────
# REDIS *** REQUEST FROM AEAD IT (if available)
# ─────────────────────────────────────────────────────────────────────────
# Used for session state and caching
REDIS_HOST=redis.internal.aead.gob.es
REDIS_PORT=6379
# Or use full URL instead:
# REDIS_URL=redis://redis.internal.aead:6379

# ─────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONSOLE=false
LOG_DIR=/var/log/aurea
LOG_EVENT_LOOP=false

# ─────────────────────────────────────────────────────────────────────────
# AI GATEWAY — for on-prem deployment
# ─────────────────────────────────────────────────────────────────────────
# Leave empty for cloud (ALIA + Anthropic).
# When AEAD deploys on-prem ALIA LLM, they provide the URL.

# Primary AI endpoint (on-prem vLLM/TGI compatible with OpenAI API)
# Example: http://gpu-server.internal.aead:8000/v1
AI_PRIMARY_GATEWAY_URL=

# Model name for primary (when using on-prem)
AI_PRIMARY_MODEL=

# API key for primary (if on-prem requires auth)
AI_PRIMARY_API_KEY=

# Fallback AI (leave empty = Anthropic cloud)
AI_FALLBACK_GATEWAY_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# CLOUD AI (fallback if no on-prem)
# ─────────────────────────────────────────────────────────────────────────
ALIA_API_KEY=
ALIA_BASE_URL=https://api.nextbit256.com/onemillion/llm/v1
ALIA_MODEL=BSC-LT/ALIA-40b-instruct_Q8_0

ANTHROPIC_API_KEY=
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL: SSO / OIDC *** REQUEST FROM AEAD IF USING OpenAM
# ─────────────────────────────────────────────────────────────────────────
# If OIDC_ISSUER_URL is set, SSO routes are automatically enabled.
# Leave empty to disable SSO and use only local email/password auth.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://aurea.aead.gob.es/api/public/sso/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://aurea.aead.gob.es
OIDC_SCOPES=openid profile email

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL: FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────
# SSO_ENABLED is automatically set to true if OIDC_ISSUER_URL is configured.
# No need to set manually — it's auto-detected.

# Enable local email/password registration endpoint (POST /auth/register)
# Default: false (AEAD uses SSO or manual admin user creation only)
LOCAL_AUTH_ENABLED=false

# Enable Swagger UI documentation (recommended true in dev/staging only)
# Default: false in production, true otherwise
SWAGGER_ENABLED=false
