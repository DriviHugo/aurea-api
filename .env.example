# =============================================================================
# AUREA API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] have sensible defaults.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="aurea-api"                          # [OPTIONAL] App identifier
APP_HOST="127.0.0.1"                          # [OPTIONAL] Bind address
APP_PORT="4789"                               # [OPTIONAL] HTTP port
FRONTEND_BASE_URL="http://localhost:8080"      # [REQUIRED] Frontend URL (used for CORS)
NODE_ENV="development"                         # [REQUIRED] development | production | test

# -----------------------------------------------------------------------------
# Database (PostgreSQL 17)
# Port 54320 = local docker-compose, 5432 = default/staging
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:54320/aurea"  # [REQUIRED]

# -----------------------------------------------------------------------------
# Authentication (JWT)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=""                         # [REQUIRED] JWT access token signing secret
REFRESH_TOKEN_SECRET=""                        # [REQUIRED] JWT refresh token signing secret
EMAIL_VALIDATION_SECRET=""                     # [REQUIRED] Email validation token secret
COOKIE_SECRET=""                               # [REQUIRED] Cookie signing secret

# -----------------------------------------------------------------------------
# AI Configuration
# Primary provider is configured via AI_* and ALIA_*; Anthropic is the optional fallback.
# -----------------------------------------------------------------------------
AI_PROVIDER="ollama"                           # [OPTIONAL] ollama | anthropic | azure-openai | gemini
AI_API_KEY=""                                  # [OPTIONAL] API key for the primary provider
AI_BASE_URL=""                                 # [OPTIONAL] Base URL (required for ollama/azure)
AI_MODEL=""                                    # [OPTIONAL] Model name (defaults per provider)
AI_TEMPERATURE="0.7"                           # [OPTIONAL] Sampling temperature
AI_MAX_TOKENS="4096"                           # [OPTIONAL] Max output tokens

# ALIA (primary provider in production gateway)
ALIA_API_KEY=""                                # [OPTIONAL] ALIA key
ALIA_BASE_URL="https://api.nextbit256.com/onemillion/llm/v1"
ALIA_MODEL="BSC-LT/ALIA-40b-instruct_Q8_0"

# Anthropic fallback (used when ALIA fails)
ANTHROPIC_API_KEY=""                           # [OPTIONAL] Anthropic key (fallback only)
FORCE_FALLBACK="false"                         # [OPTIONAL] Skip primary, go straight to fallback

# -----------------------------------------------------------------------------
# SSO / OIDC (Optional - for OpenAM / Keycloak integration)
# Leave empty to use local email/password auth only.
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=""                             # [OPTIONAL] OIDC provider base URL
OIDC_CLIENT_ID=""                              # [OPTIONAL] Client ID
OIDC_CLIENT_SECRET=""                          # [OPTIONAL] Client secret
OIDC_REDIRECT_URI="http://localhost:4789/api/public/sso/callback"
OIDC_POST_LOGOUT_REDIRECT_URI="http://localhost:8080"
OIDC_SCOPES="openid profile email"

# -----------------------------------------------------------------------------
# Redis
# Port 35302 = local docker-compose, 6379 = default/staging
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"                         # [OPTIONAL]
REDIS_PORT="35302"                             # [OPTIONAL]

# -----------------------------------------------------------------------------
# MinIO / S3 Storage
# -----------------------------------------------------------------------------
MINIO_ENDPOINT="localhost"                     # [OPTIONAL]
MINIO_PORT="9000"                              # [OPTIONAL]
MINIO_ACCESS_KEY="minioadmin"                  # [OPTIONAL]
MINIO_SECRET_KEY="minioadmin"                  # [OPTIONAL]
MINIO_USE_SSL="false"                          # [OPTIONAL]
MINIO_BUCKET_DOCUMENTS="documents"             # [OPTIONAL]
MINIO_BUCKET_IMAGES="images"                   # [OPTIONAL]

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
EMAIL_HOST="localhost"                         # [OPTIONAL]
EMAIL_PORT="1025"                              # [OPTIONAL] 1025 = Mailpit dev
EMAIL_AUTH_USER=""                              # [OPTIONAL]
EMAIL_AUTH_PASS=""                              # [OPTIONAL]
EMAIL_FROM="noreply@aurea.com"                 # [OPTIONAL]

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL="info"                               # [OPTIONAL] debug | info | warn | error
LOG_FORMAT="pretty"                            # [OPTIONAL] pretty | json
LOG_CONSOLE="true"                             # [OPTIONAL] Log to stdout
LOG_DIR="logs"                                 # [OPTIONAL] Log file directory
