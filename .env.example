# =============================================================================
# Lovable Migration Boilerplate - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myproject"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/myproject"

# -----------------------------------------------------------------------------
# Production AI Configuration (Application Runtime)
# Provider-agnostic: ollama (local), openai, azure-openai, gemini, anthropic
# -----------------------------------------------------------------------------
AI_PROVIDER="ollama"
AI_MODEL="llama3.3:70b"
AI_BASE_URL="http://localhost:11434"  # For Ollama/Azure custom endpoints
AI_API_KEY=""  # Required for OpenAI, Azure, Gemini, Anthropic
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="4096"

# Azure OpenAI Government (ENS Alto compliance)
# AI_PROVIDER="azure-openai"
# AI_BASE_URL="https://your-resource.openai.azure.com"
# AI_API_KEY="your-azure-api-key"
# AI_MODEL="gpt-4"  # Deployment name

# Google Gemini
# AI_PROVIDER="gemini"
# AI_API_KEY="your-gemini-api-key"
# AI_MODEL="gemini-2.0-flash-exp"

# -----------------------------------------------------------------------------
# Migration AI Configuration (Code Generation Only - Development)
# Separate from production AI to avoid mixing concerns
# -----------------------------------------------------------------------------
MIGRATION_AI_PROVIDER="anthropic"  # anthropic or gemini
ANTHROPIC_API_KEY=""  # For Claude Sonnet 4.5
GEMINI_API_KEY=""     # Alternative: Gemini 3

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# Keycloak (Optional - for SSO/MFA)
# KEYCLOAK_URL="http://localhost:8080"
# KEYCLOAK_REALM="myproject"
# KEYCLOAK_CLIENT_ID="myproject-api"
# KEYCLOAK_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Redis (Rate Limiting)
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# -----------------------------------------------------------------------------
# MinIO Storage (S3-Compatible)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL="false"
MINIO_BUCKET_DOCUMENTS="documents"
MINIO_BUCKET_IMAGES="images"

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"  # Mailpit for development
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@myproject.com"

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
LOG_LEVEL="info"  # debug, info, warn, error
LOG_RETENTION_DAYS="90"  # Adjust based on your compliance requirements

# Prometheus
PROMETHEUS_PORT="9090"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
NODE_ENV="development"  # production, development, test
API_PORT="3000"
CORS_ORIGIN="http://localhost:5173"  # Frontend URL

# Rate Limiting (per IP)
RATE_LIMIT_MAX="1000"
RATE_LIMIT_WINDOW="15m"

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS="30"  # ENS Alto requires 30 days
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
