# App
APP_NAME = boilerplate-api
APP_VERSION = 1.1.0
APP_HOST = 127.0.0.1
APP_PORT = 4789
APP_BASE_ENDPOINT = http://localhost:4789

APP_SOCKET_HOST = 127.0.0.1
APP_SOCKET_PORT = 1337

API_KEY = 60553d58c41f5dfa095b34b9

# Database MongoDB
# DATABASE_URL = mongodb://@127.0.0.1:26943/boilerplate-api?retryWrites=true&w=majority

# Database PostgreSQL
DATABASE_URL = "postgresql://postgres:postgres@127.0.0.1:54320/boilerplate-api?sslmode=disable"

# Redis
REDIS_HOST = 127.0.0.1
REDIS_PORT = 35302

# Log
LOG_LEVEL = debug
LOG_DIR = logs
LOG_FORMAT = dev
LOG_CONSOLE = 1
LOG_EVENT_LOOP = 1
LOG_ORIGIN_REQUEST_ID_HEADER = x-origin-request-id

# Frontend
FRONTEND_BASE_URL = http://localhost:3000
FRONTEND_RESET_PASSWORD_URL = ${FRONTEND_BASE_URL}/reset-password

# Mailer
EMAIL_FROM =
EMAIL_AUTH_USER =
EMAIL_AUTH_PASS =
COMPANY_NAME = boilerplate-company

# Crypto
COOKIE_SIGN_SECRET = "defaultCookieSecret"
ACCESS_TOKEN_SECRET = "defaultAccessTokenSecret"
REFRESH_TOKEN_SECRET = "defaultRefreshTokenSecret"
EMAIL_VALIDATION_SECRET = "defaultEmailValidationSecret"
