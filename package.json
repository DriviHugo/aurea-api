{
  "name": "migration-boilerplate",
  "version": "1.0.0",
  "description": "Boilerplate for a Node.js API with Fastify, Prisma (MongoDB or PostgreSQL) and Redis",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#app/*": "./dist/*"
  },
  "scripts": {
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --detectOpenHandles",
    "test:migration": "tsx test-migration.ts",
    "test:quick": "npx tsx quick-test.ts",
    "test:real": "npx tsx test-real-endpoints.ts",
    "user:create": "node create-user-simple.mjs",
    "lint": "eslint --config eslint.config.js ./src ./test --ext .ts,.tsx",
    "lint:fix": "eslint --config eslint.config.js --fix ./src ./test --ext .ts,.tsx",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:status": "npx prisma migrate status",
    "db:reset": "npx prisma migrate reset --force",
    "db:seed": "node prisma/seed.js",
    "docker:up": "docker-compose -f ./docker/docker-compose.yml up -d --build",
    "docker:down": "docker-compose -f ./docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f ./docker/docker-compose.yml logs -f",
    "migrate:inspect": "tsx --env-file=.env migration/inspectors/project-inspector.ts",
    "migrate:schema": "tsx --env-file=.env migration/ai-migrators/schema-migrator.ts",
    "migrate:routes": "tsx --env-file=.env migration/ai-migrators/route-generator.ts",
    "migrate:hooks": "tsx --env-file=.env migration/ai-migrators/hook-transformer.ts",
    "migrate:functions": "tsx --env-file=.env migration/ai-migrators/function-migrator.ts",
    "migrate:auth": "tsx --env-file=.env migration/ai-migrators/auth-generator.ts",
    "migrate:users": "tsx --env-file=.env migration/scripts/migrate-users.ts",
    "migrate:all": "tsx --env-file=.env migration/migrate-all.ts",
    "migrate:validate": "tsx migration/scripts/validate-schema.ts",
    "migrate:frontend": "tsx migration/ai-migrators/component-refactor.ts",
    "migrate:types": "tsx migration/scripts/generate-types.ts",
    "migrate:docker": "tsx migration/scripts/setup-docker.ts",
    "prepare": "husky",
    "migrate:auto": "tsx migration/migrate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "1MillionBot",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/bcryptjs": "^2.4.6",
    "ajv": "^8.17.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "blocked": "^1.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "glob": "^13.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.6",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^7.1.1",
    "request-ip": "^3.3.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.11.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcrypt": "~10.0.28-alpha",
    "@types/blocked": "~1.3.5",
    "@types/compression": "~1.8.1",
    "@types/eslint-plugin-security": "~3.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "~9.0.10",
    "@types/morgan": "~1.9.10",
    "@types/node": "^24.0.14",
    "@types/nodemailer": "~6.4.17",
    "@types/request-ip": "~0.0.41",
    "@types/supertest": "~6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-es": "^4.1.0",
    "eslint-plugin-jest": "^29.11.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "fastify-tsconfig": "^3.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  }
}
